# WYD CDK - Configurações Apache
DirectoryIndex index.php index.html

# Proteger arquivos de configuração sensíveis e bibliotecas
<FilesMatch "\.(json|sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir upload e visualização de BMPs de Guildmark
<FilesMatch "\.(bmp|png|jpg|jpeg|gif|ico|mp3|css|js)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
